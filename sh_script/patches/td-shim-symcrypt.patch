diff --git a/td-exception/src/asm/handler.asm b/td-exception/src/asm/handler.asm
index 9be9f0d..96c1dc2 100644
--- a/td-exception/src/asm/handler.asm
+++ b/td-exception/src/asm/handler.asm
@@ -4,6 +4,21 @@
 # Mask the exception vectors that push an error code on the stack
 .equ EXCEPTION_ERROR_CODE_MASK, 0x20027d00
 
+.macro save_fx_state
+        sub rsp, 512
+        and rsp, -16
+        fxsave64 [rsp]
+.endm
+
+.macro restore_fx_state
+        fxrstor64 [rsp]
+        # Wipe the spill using GPRs only; restored XMM registers may hold secrets.
+        mov rdi, rsp
+        mov ecx, 64
+        xor eax, eax
+        rep stosq
+.endm
+
 .section .text
 interrupt_handler_entry:
         push rax
@@ -23,7 +38,12 @@ interrupt_handler_entry:
         push r15
 
         mov rdi, rsp
+        mov rbx, rsp
+        save_fx_state
+        cld
         call generic_interrupt_handler
+        restore_fx_state
+        mov rsp, rbx
 
         pop r15
         pop r14
