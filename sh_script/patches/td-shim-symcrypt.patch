diff --git a/td-shim/src/crypto.rs b/td-shim/src/crypto.rs
new file mode 100644
index 0000000..3214d70
--- /dev/null
+++ b/td-shim/src/crypto.rs
@@ -0,0 +1,118 @@
+// Copyright (c) 2026 Microsoft Corporation
+//
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+
+use core::convert::TryInto;
+use symcrypt_core::{Error, Result};
+
+/// Initialize the native backend before measurements or key operations.
+///
+/// # Safety
+/// The allocator and SSE state must be available, and all interrupt/exception
+/// paths must preserve XMM state. No interrupt may call cryptography.
+pub unsafe fn initialize() -> Result<()> {
+    #[cfg(target_os = "none")]
+    {
+        // SAFETY: the caller establishes the firmware ABI/interrupt contract.
+        unsafe { symcrypt_core::platform::initialize_with_platform(&PLATFORM) }
+    }
+    #[cfg(not(target_os = "none"))]
+    {
+        symcrypt_core::platform::ensure_initialized()
+    }
+}
+
+pub fn digest_sha384(data: &[u8]) -> Result<[u8; 48]> {
+    symcrypt_core::hash::Algorithm::Sha384
+        .digest(data)?
+        .try_into()
+        .map_err(|_| Error::InvalidLength)
+}
+
+#[cfg(target_os = "none")]
+static PLATFORM: symcrypt_core::platform::Platform = symcrypt_core::platform::Platform {
+    cpuid,
+    entropy,
+    fatal: |_| {
+        // Never unwind through a native frame, including a failed stack check.
+        unsafe { core::arch::asm!("cli", options(nomem, nostack)) };
+        loop {
+            unsafe { core::arch::asm!("hlt", options(nomem, nostack)) };
+        }
+    },
+};
+
+#[cfg(target_os = "none")]
+fn cpuid(leaf: u32, subleaf: u32) -> [u32; 4] {
+    #[allow(unused_unsafe)]
+    let result = unsafe { core::arch::x86_64::__cpuid_count(leaf, subleaf) };
+    [result.eax, result.ebx, result.ecx, result.edx]
+}
+
+#[cfg(target_os = "none")]
+fn entropy(output: &mut [u8]) -> Result<()> {
+    use zeroize::Zeroize;
+
+    if cpuid(0, 0)[0] < 7 || cpuid(7, 0)[1] & (1 << 18) == 0 {
+        output.zeroize();
+        return Err(Error::EntropyUnavailable);
+    }
+    fill_entropy(output, || {
+        let mut word = zeroize::Zeroizing::new(0);
+        // SAFETY: RDSEED support was checked using the TD's CPUID results.
+        if unsafe { core::arch::x86_64::_rdseed64_step(&mut word) } == 1 {
+            Some(*word)
+        } else {
+            core::hint::spin_loop();
+            None
+        }
+    })
+}
+
+#[cfg(any(target_os = "none", test))]
+fn fill_entropy(output: &mut [u8], mut read: impl FnMut() -> Option<u64>) -> Result<()> {
+    use zeroize::{Zeroize, Zeroizing};
+
+    for chunk in output.chunks_mut(8) {
+        let Some(word) = (0..1024).find_map(|_| read()) else {
+            output.zeroize();
+            return Err(Error::EntropyUnavailable);
+        };
+        let word = Zeroizing::new(word);
+        let bytes = Zeroizing::new(word.to_ne_bytes());
+        chunk.copy_from_slice(&bytes[..chunk.len()]);
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn seed_retry_exhaustion_wipes_partial_output() {
+        let mut calls = 0;
+        let mut output = [0xa5; 48];
+        let result = fill_entropy(&mut output, || {
+            calls += 1;
+            (calls == 1).then_some(0x123456789abcdef0)
+        });
+        assert_eq!(result, Err(Error::EntropyUnavailable));
+        assert_eq!(calls, 1025);
+        assert_eq!(output, [0; 48]);
+    }
+
+    #[test]
+    fn seed_retry_success_and_partial_word() {
+        let mut calls = 0;
+        let mut output = [0; 13];
+        fill_entropy(&mut output, || {
+            calls += 1;
+            (calls % 2 == 0).then_some(0x0102030405060708)
+        })
+        .unwrap();
+        assert_eq!(calls, 4);
+        assert_eq!(&output[..8], &0x0102030405060708u64.to_ne_bytes());
+        assert_eq!(&output[8..], &0x0102030405060708u64.to_ne_bytes()[..5]);
+    }
+}
